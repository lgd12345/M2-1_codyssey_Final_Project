# Copy to backend/.env. Never commit secrets.
#
# Which database does the application use?  RAG_DATABASE_URL if set, otherwise DATABASE_URL (see app/config.py).
# The server logs the database NAME it chose and warns when DATABASE_URL is being ignored. Keep both pointing at the
# same, fully migrated database, or set only DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/service_poc
RAG_DATABASE_URL=

# TEST_DATABASE_URL is never the application database. scripts/test_isolated.py connects with it only to create and
# drop a disposable database (rag_regression_<id>_test) for the regression tests; the ingestion scripts also default to
# it, so ingest into the application database explicitly (--database-url-env). Never run pytest directly against it.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/service_poc_test

# Run ONE server process. Analysis runs inside the web process and recovery of interrupted analyses assumes it.
# WEB_CONCURRENCY greater than 1 is logged as a warning at startup.

# OpenAI-compatible chat-completions proxy for the agent (base URL, usually ending in /v1).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Optional. Sent as prompt_cache_key only when set; leave empty unless the gateway is known to accept it.
LLM_PROMPT_CACHE_KEY=

# OpenAI-compatible Gemini embeddings proxy base (client appends /embeddings).
GEMINI_EMBEDDING_BASE_URL=
GEMINI_EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_MAX_RETRIES=5
GEMINI_EMBEDDING_BACKOFF_SECONDS=1
GEMINI_EMBEDDING_MAX_BACKOFF_SECONDS=30

# Login: sessions are HttpOnly cookies. Set to 1 when served over HTTPS.
# Accounts are created only with `python scripts/create_user.py --login-id <id>` (no public sign-up).
APP_COOKIE_SECURE=0

# Local PDF render cache; disposable and safe to delete.
PDF_RENDER_CACHE_DIR=data/render_cache
PDF_RENDER_DPI=150
