# Copy to backend/.env. Never commit secrets.
#
# The minimum to run the application is the "Required" block (the embedding key only if your server needs one).
# Everything else has a default (shown commented out) and only needs to be set to change it.

# ---------------------------------------------------------------- Required
# The application database: one variable, fully migrated (python scripts/migrate.py --env-name DATABASE_URL
# --allow-non-test). The server logs the database NAME it uses at startup.
DATABASE_URL=postgresql://user:password@localhost:5432/service_poc

# OpenAI-compatible chat-completions proxy for the AI analysis (base URL, usually ending in /v1).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding server for vector search (Qwen is the default provider; the client appends /embeddings).
# Without it, search is keyword-only.
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_API_KEY=

# ---------------------------------------------------------------- Optional (defaults shown)
# LLM_TIMEOUT_SECONDS=60
# Sent as prompt_cache_key only when set; leave unset unless the gateway is known to accept it.
# LLM_PROMPT_CACHE_KEY=
# QWEN_EMBEDDING_MODEL=qwen3-embedding-0.6b
# QWEN_EMBEDDING_DIMENSION=1024
# QWEN_EMBEDDING_TIMEOUT_SECONDS=240
# QWEN_EMBEDDING_MAX_RETRIES=2

# Original manual pages are rendered from the PDFs recorded at ingestion; the rendered images are cached here
# (disposable, safe to delete).
# PDF_RENDER_CACHE_DIR=data/render_cache
# PDF_RENDER_DPI=150

# Sessions are HttpOnly cookies. The Docker image sets this to 1 (HTTPS); leave it unset for plain-http local use.
# APP_COOKIE_SECURE=1

# Run ONE server process. Analysis runs inside the web process and recovery of interrupted analyses assumes it;
# WEB_CONCURRENCY greater than 1 is logged as a warning at startup. (Not something to put in this file.)

# Corpus directory for scripts/ingest_corpus.py (default: backend/data/test_corpus).
# RAG_CORPUS_DIR=

# Gemini embeddings: an alternative provider, used only when RAG_EMBEDDING_PROVIDER=gemini.
# RAG_EMBEDDING_PROVIDER=gemini
# GEMINI_EMBEDDING_BASE_URL=
# GEMINI_EMBEDDING_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_EMBEDDING_TIMEOUT_SECONDS=30
# GEMINI_EMBEDDING_MAX_RETRIES=5
# GEMINI_EMBEDDING_BACKOFF_SECONDS=1
# GEMINI_EMBEDDING_MAX_BACKOFF_SECONDS=30

# ---------------------------------------------------------------- Tests and one-off scripts only
# TEST_DATABASE_URL is never the application database. scripts/test_isolated.py connects with it only to create and
# drop a disposable database (rag_regression_<id>_test) for the regression tests; the ingestion scripts also default
# to it, so ingest into the application database explicitly (--database-url-env DATABASE_URL). Never run pytest
# directly against it.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/service_poc_test

# Accounts are created only with `python scripts/create_user.py --login-id <id>` (no public sign-up); its password
# comes from a hidden prompt, or APP_NEW_PASSWORD for automation. It is an input to that script, not configuration.
