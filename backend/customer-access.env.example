# Non-secret production settings. Missing/invalid keys keep access unavailable.
CUSTOMER_ACCESS_ENABLED=1
CUSTOMER_ACCESS_RELEASE_APPROVED=1
CUSTOMER_REGISTRATION_ENABLED=1
APP_COOKIE_SECURE=1
CUSTOMER_ACCESS_SECRET=
# Full Google account email. Use a dedicated sending account where possible.
CUSTOMER_SMTP_USERNAME=hellopopoberry@gmail.com
# Google 16-character APP password, never the normal Google account password.
CUSTOMER_SMTP_PASSWORD=
# Optional; blank uses CUSTOMER_SMTP_USERNAME. A different From is rejected.
CUSTOMER_MAIL_FROM=
CUSTOMER_ACCESS_POLICY_FILE=/app/app/customer_access/policy.json
# Gmail SMTP uses smtp.gmail.com:465 with TLS and certificate verification.
# Inject these values into the existing server container environment. Copying
# this example into Git or rebuilding the image does not configure the server.
# Existing DATABASE_URL is the explicit customer-access data target.
# Registration additionally requires the auth DSN to match DATABASE_URL exactly.
# Registration requires migrations 001, 002 and 003; startup never applies them.
# Guest-only access can use a separate business DB.
# APP_COOKIE_SECURE=1 is required to activate either feature.
# Management uses a separate explicitly selected administrative DSN, never fallback:
CUSTOMER_ACCESS_MIGRATION_DATABASE_URL=
